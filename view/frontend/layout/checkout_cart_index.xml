<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart.summary">
            <block class="Webcode\FreeShippingReminder\Block\Reminder" name="free-shipping-reminder-cart" template="Webcode_FreeShippingReminder::reminder.phtml" before="-">
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="cart-free-shipping-reminder" xsi:type="array">
                                <item name="component" xsi:type="string">Webcode_FreeShippingReminder/js/view/free-shipping-reminder</item>
                                <item name="config" xsi:type="array">
                                    <item name="template" xsi:type="string">Webcode_FreeShippingReminder/free-shipping-reminder/content</item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="free-shipping-reminder-minicart" remove="true"/>

    </body>
</page>
